{
  "name": "eslint-plugin-markdown-preferences-paragraph",
  "version": "0.2.1",
  "description": "An ESLint plugin for checking and safely fixing Markdown paragraph wrapping.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "assets/logo.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "RELEASING.md"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "lint": "npm run lint:code && npm run lint:markdown && npm run lint:workflows",
    "lint:code": "eslint .",
    "lint:markdown": "eslint --config eslint.config-markdown.js \"*.md\"",
    "lint:workflows": "node scripts/check-workflow-names.js",
    "release": "node scripts/release.js",
    "package:check": "node --test test/integration.test.js"
  },
  "dependencies": {
    "string-width": "^8.3.0"
  },
  "peerDependencies": {
    "@eslint/markdown": "^8.0.0",
    "eslint": "^9.39.0 || ^10.0.0"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.6"
    }
  },
  "devDependencies": {
    "@cspell/dict-software-terms": "^5.4.9",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-markdown-preferences": "^0.43.0",
    "eslint-plugin-prose-spellcheck": "0.1.1",
    "release-it": "^21.1.2",
    "title-case": "^4.3.2",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/eslint-plugin-markdown-preferences-paragraph.git"
  },
  "bugs": {
    "url": "https://github.com/dblock/eslint-plugin-markdown-preferences-paragraph/issues"
  },
  "homepage": "https://github.com/dblock/eslint-plugin-markdown-preferences-paragraph#readme",
  "license": "MIT",
  "author": "dblock",
  "keywords": [
    "eslint",
    "eslintplugin",
    "markdown",
    "paragraph",
    "wrap"
  ],
  "c8": {
    "include": [
      "src/**/*.js",
      "scripts/**/*.js"
    ]
  }
}
