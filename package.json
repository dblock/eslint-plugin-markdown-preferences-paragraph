{
  "name": "eslint-plugin-markdown-preferences-paragraph-wrap",
  "version": "0.2.0",
  "description": "An ESLint plugin for checking and safely fixing Markdown paragraph wrapping.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "RELEASING.md"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "lint": "npm run lint:code && npm run lint:markdown && npm run lint:workflows",
    "lint:code": "eslint .",
    "lint:markdown": "eslint --config eslint.config-markdown.js \"*.md\" && markdownlint-cli2 \"*.md\"",
    "lint:workflows": "node scripts/check-workflow-names.js",
    "package:check": "node --test test/integration.test.js"
  },
  "dependencies": {
    "string-width": "^8.3.0"
  },
  "peerDependencies": {
    "@eslint/markdown": "^8.0.0",
    "eslint": "^9.39.0 || ^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@cspell/dict-software-terms": "^5.4.9",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-markdown-preferences": "^0.43.0",
    "markdown-it": "^15.0.3",
    "markdownlint": "^0.42.0",
    "markdownlint-cli2": "^0.24.0",
    "markdownlint-rule-single-line-paragraphs": "^0.2.0",
    "markdownlint-rule-spellcheck": "^0.2.0",
    "markdownlint-rule-title-case-style": "^0.4.3",
    "title-case": "^4.3.2",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/eslint-plugin-markdown-preferences-paragraph-wrap.git"
  },
  "bugs": {
    "url": "https://github.com/dblock/eslint-plugin-markdown-preferences-paragraph-wrap/issues"
  },
  "homepage": "https://github.com/dblock/eslint-plugin-markdown-preferences-paragraph-wrap#readme",
  "license": "MIT",
  "author": "dblock",
  "keywords": [
    "eslint",
    "eslintplugin",
    "markdown",
    "paragraph",
    "wrap"
  ],
  "c8": {
    "include": ["src/**/*.js", "scripts/check-workflow-names.js"]
  }
}
